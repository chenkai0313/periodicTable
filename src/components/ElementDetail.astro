---
import ElectronShell from './ElectronShell.astro';
import {
  getCategoryColor, getCategoryLabel, getCategoryLabelZh,
  formatTemperature, formatDensity,
  STATE_LABELS, BLOCK_LABELS, CRYSTAL_LABELS, COUNTRY_LABELS, USES_ZH, CATEGORIES,
  getAllElements,
} from '../utils/elements';
import type { ElementData } from '../utils/elements';

interface Props { element: ElementData; locale?: string; }
const { element: e, locale = 'en' } = Astro.props;
const glowColor = getCategoryColor(e.category);

const catEn = getCategoryLabel(e.category);
const catZh = getCategoryLabelZh(e.category);
const stateEn = e.state.charAt(0).toUpperCase() + e.state.slice(1);
const stateZh = STATE_LABELS[e.state] || e.state;
const blockEn = e.block + '-block';
const blockZh = BLOCK_LABELS[e.block] || (e.block + '区');
const crystalInfo = e.crystal ? (CRYSTAL_LABELS[e.crystal] || { en: e.crystal, zh: e.crystal }) : null;
const countryZh = e.country ? (COUNTRY_LABELS[e.country] || e.country) : '';
const yearText = e.year ? String(e.year) : 'Ancient';
const yearTextZh = e.year ? String(e.year) + ' 年' : '古代';
const discovererText = e.discoverer || '—';

// Related elements: same group and same period
const allElements = getAllElements();
const sameGroup = allElements.filter(el => el.group === e.group && el.z !== e.z && e.group != null).slice(0, 4);
const samePeriod = allElements.filter(el => el.period === e.period && el.z !== e.z).slice(0, 4);

// Safety info based on category and properties
const safetyInfo = getSafetyInfo(e);

function getSafetyInfo(el: ElementData) {
  const warnings: string[] = [];
  const zhWarnings: string[] = [];

  if (el.category === 'actinide' || el.z >= 84) {
    warnings.push('Radioactive — handle only in licensed facilities with proper shielding.');
    zhWarnings.push('放射性元素——仅在持证设施中并使用适当防护的情况下处理。');
  }
  if (el.category === 'halogen') {
    warnings.push('Highly reactive halogen gas — toxic if inhaled, causes severe burns on contact.');
    zhWarnings.push('高活性卤素——吸入有毒，接触会造成严重灼伤。');
  }
  if (el.category === 'alkali') {
    warnings.push('Extremely reactive with water — store under mineral oil. Can cause fire or explosion on water contact.');
    zhWarnings.push('与水极度反应——储存于矿物油中。遇水可引发火灾或爆炸。');
  }
  if (['mercury', 'lead', 'arsenic', 'cadmium', 'thallium', 'beryllium'].includes(el.nameEn.toLowerCase())) {
    warnings.push('Toxic — avoid inhalation of dust or fumes. Chronic exposure may cause serious health effects.');
    zhWarnings.push('有毒——避免吸入粉尘或烟雾。长期接触可能导致严重健康影响。');
  }
  if (el.category === 'noble') {
    warnings.push('Generally inert and non-toxic. Asphyxiation risk only in confined spaces at high concentrations.');
    zhWarnings.push('通常为惰性无毒气体。仅在密闭空间高浓度时有窒息风险。');
  }

  if (warnings.length === 0) {
    warnings.push('Handle with standard laboratory precautions. Refer to the Safety Data Sheet (SDS) for detailed handling instructions.');
    zhWarnings.push('按照标准实验室预防措施处理。详细操作说明请参阅安全数据表（SDS）。');
  }

  return { en: warnings, zh: zhWarnings };
}
---

<article class="detail-root">
  <div class="detail-header" style={`--accent: ${glowColor};`}>
    <div class="detail-top-row">
      <a href={`/${locale}`} class="back-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="lang-en">Back to Table</span>
        <span class="lang-zh">返回周期表</span>
      </a>
      <div class="detail-nav">
        {e.z > 1 && <a href={`/${locale}/element/${e.z - 1}`} target="_blank" class="nav-arrow" title="Previous element">&larr; #{e.z - 1}</a>}
        <span class="nav-current">#{e.z}</span>
        {e.z < 118 && <a href={`/${locale}/element/${e.z + 1}`} target="_blank" class="nav-arrow" title="Next element">#{e.z + 1} &rarr;</a>}
      </div>
    </div>
    <div class="detail-hero">
      <span class="detail-z">{e.z}</span>
      <h1 class="detail-symbol" style={`color: ${glowColor};`}>
        {e.symbol}
      </h1>
      <div class="detail-names">
        <span class="detail-name-en lang-en">{e.nameEn}</span>
        <span class="detail-name-zh lang-zh">{e.nameZh}</span>
      </div>
    </div>
  </div>

  <!-- Introduction -->
  <div class="detail-intro glass-glow">
    <p class="lang-en">{e.nameEn} is a <strong style={`color:${glowColor}`}>{catEn}</strong> element with the symbol <strong>{e.symbol}</strong> and atomic number {e.z}. Located in period {e.period}{e.group ? `, group ${e.group}` : ''} ({e.block}-block), it has an atomic weight of <strong>{e.weight} u</strong> and is classified as a <strong>{stateEn.toLowerCase()}</strong> at standard temperature and pressure. {e.year ? `First identified in ${yearText}` : `Known since ${yearText.toLowerCase()}`}{e.discoverer ? ` by ${e.discoverer}` : ''}{e.country ? ` in ${e.country}` : ''}. {e.nameEn} has an electron configuration of <strong>{e.electronConfig}</strong> with {e.shells.length} electron shells containing {e.shells.join(', ')} electrons respectively. {e.uses ? `It is commonly used in: ${e.uses.toLowerCase()}.` : ''}</p>
    <p class="lang-zh">{e.nameZh}是一种<strong style={`color:${glowColor}`}>{catZh}</strong>元素，符号为<strong>{e.symbol}</strong>，原子序数为{e.z}。位于第{e.period}周期{e.group ? `，第${e.group}族` : ''}（{e.block}区），原子量为<strong>{e.weight} u</strong>，在标准温度和压力下为<strong>{stateZh}</strong>。{e.year ? `于${yearTextZh}首次被确认` : `自古以来即为人类所知`}{e.discoverer ? `，由${e.discoverer}发现` : ''}{e.countryZh ? `（${countryZh}）` : ''}。{e.nameZh}的电子排布为<strong>{e.electronConfig}</strong>，具有{e.shells.length}个电子层，分别含有{e.shells.join('、')}个电子。{e.uses ? `常见用途包括：${USES_ZH[e.uses] || e.uses}。` : ''}</p>
  </div>

  <div class="detail-grid">
    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Basic Properties</span><span class="lang-zh">基本属性</span></h3>
      <dl class="prop-list">
        <div class="prop-row"><dt><span class="lang-en">Atomic Number</span><span class="lang-zh">原子序数</span></dt><dd>{e.z}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Atomic Weight</span><span class="lang-zh">原子量</span></dt><dd>{e.weight} u</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Category</span><span class="lang-zh">分类</span> <button class="cat-info-btn" id="cat-info-btn" aria-label="Category info">?</button></dt><dd style={`color:${glowColor}`}><span class="lang-en cap">{catEn}</span><span class="lang-zh">{catZh}</span></dd></div>
        <div class="prop-row"><dt><span class="lang-en">State at STP</span><span class="lang-zh">标准状态</span></dt><dd><span class="lang-en cap">{stateEn}</span><span class="lang-zh">{stateZh}</span></dd></div>
        <div class="prop-row"><dt><span class="lang-en">Period</span><span class="lang-zh">周期</span></dt><dd>{e.period}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Group</span><span class="lang-zh">族</span></dt><dd>{e.group ?? '—'}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Block</span><span class="lang-zh">区</span></dt><dd><span class="lang-en cap">{blockEn}</span><span class="lang-zh">{blockZh}</span></dd></div>
      </dl>
    </div>

    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Physical Properties</span><span class="lang-zh">物理性质</span></h3>
      <dl class="prop-list">
        <div class="prop-row"><dt><span class="lang-en">Melting Point</span><span class="lang-zh">熔点</span></dt><dd>{formatTemperature(e.melting)}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Boiling Point</span><span class="lang-zh">沸点</span></dt><dd>{formatTemperature(e.boiling)}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Density</span><span class="lang-zh">密度</span></dt><dd>{formatDensity(e.density)}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Crystal Structure</span><span class="lang-zh">晶体结构</span></dt><dd>
          {crystalInfo ? (
            <><span class="lang-en cap">{crystalInfo.en}</span><span class="lang-zh">{crystalInfo.zh}</span></>
          ) : '—'}
        </dd></div>
        <div class="prop-row"><dt><span class="lang-en">Atomic Radius</span><span class="lang-zh">原子半径</span></dt><dd>{e.atomicRadius ? `${e.atomicRadius} pm` : '—'}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Ionic Radius</span><span class="lang-zh">离子半径</span></dt><dd>{e.ionicRadius ? `${e.ionicRadius} pm` : '—'}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Electronegativity</span><span class="lang-zh">电负性</span></dt><dd>{e.electronegativity ?? '—'}</dd></div>
      </dl>
    </div>

    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Electron Configuration</span><span class="lang-zh">电子排布</span></h3>
      <dl class="prop-list">
        <div class="prop-row"><dt><span class="lang-en">Config</span><span class="lang-zh">电子构型</span></dt><dd class="electron-config">{e.electronConfig}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Shells</span><span class="lang-zh">电子层</span></dt><dd>{e.shells.join(', ')}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Oxidation States</span><span class="lang-zh">氧化态</span></dt><dd>{e.oxidation.map(o => o > 0 ? `+${o}` : String(o)).join(', ')}</dd></div>
      </dl>
    </div>

    <div class="prop-card glass-glow shell-card">
      <h3><span class="lang-en">Electron Shells</span><span class="lang-zh">电子层结构</span></h3>
      <ElectronShell shells={e.shells} />
    </div>

    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Discovery</span><span class="lang-zh">发现历史</span></h3>
      <dl class="prop-list">
        <div class="prop-row"><dt><span class="lang-en">Year</span><span class="lang-zh">年份</span></dt><dd><span class="lang-en">{yearText}</span><span class="lang-zh">{yearTextZh}</span></dd></div>
        <div class="prop-row"><dt><span class="lang-en">Discoverer</span><span class="lang-zh">发现者</span></dt><dd>{discovererText}</dd></div>
        <div class="prop-row"><dt><span class="lang-en">Country</span><span class="lang-zh">国家</span></dt><dd><span class="lang-en">{e.country || '—'}</span><span class="lang-zh">{COUNTRY_LABELS[e.country] || e.country || '—'}</span></dd></div>
      </dl>
    </div>

    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Uses &amp; Applications</span><span class="lang-zh">用途</span></h3>
      <p class="prop-text lang-en">{e.uses || '—'}</p>
      <p class="prop-text lang-zh">{e.uses ? (USES_ZH[e.uses] || e.uses) : '—'}</p>
    </div>
    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Common Compounds</span><span class="lang-zh">常见化合物</span></h3>
      <p class="prop-text lang-en">{e.compoundsEn || '—'}</p>
      <p class="prop-text lang-zh">{e.compoundsZh || '—'}</p>
    </div>
    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Room Temperature</span><span class="lang-zh">常温特性</span></h3>
      <p class="prop-text lang-en">{e.roomTempNoteEn || e.color || '—'}</p>
      <p class="prop-text lang-zh">{e.roomTempNoteZh || e.colorZh || '—'}</p>
    </div>
    <div class="prop-card glass-glow">
      <h3>
        <span class="lang-en">Did You Know?</span>
        <span class="lang-zh">你知道吗？</span>
      </h3>
      <p class="prop-text lang-en">{e.triviaEn || `The name ${e.nameEn} comes from ${e.symbol} and it was ${e.year ? `first identified in ${e.year}` : 'known since ancient times'}.`}</p>
      <p class="prop-text lang-zh">{e.triviaZh || `${e.nameZh}的名称来源于其符号${e.symbol}，${e.year ? `于${e.year}年首次被确认` : '自古以来即为人类所知'}。`}</p>
    </div>
    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Memory Aid</span><span class="lang-zh">记忆口诀</span></h3>
      <p class="prop-text mnemonic lang-en">{e.mnemonicEn}</p>
      <p class="prop-text mnemonic-zh lang-zh">{e.mnemonicZh}</p>
    </div>
    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Appearance</span><span class="lang-zh">外观</span></h3>
      <p class="prop-text cap lang-en">{e.color}</p>
      <p class="prop-text lang-zh">{e.colorZh || e.color}</p>
    </div>
    <div class="prop-card glass-glow">
      <h3><span class="lang-en">Safety Information</span><span class="lang-zh">安全须知</span></h3>
      <ul class="prop-list prop-list-bullet lang-en">
        {safetyInfo.en.map(w => <li>{w}</li>)}
      </ul>
      <ul class="prop-list prop-list-bullet lang-zh">
        {safetyInfo.zh.map(w => <li>{w}</li>)}
      </ul>
    </div>
    {sameGroup.length > 0 && (
      <div class="prop-card glass-glow">
        <h3><span class="lang-en">Related Elements (Same Group {e.group})</span><span class="lang-zh">相关元素（同第{e.group}族）</span></h3>
        <div class="related-grid">
          {sameGroup.map(el => (
            <a href={`/${locale}/element/${el.z}`} target="_blank" class="related-chip" style={`--chip-color: ${getCategoryColor(el.category)}`}>
              <span class="related-symbol">{el.symbol}</span>
              <span class="lang-en">{el.nameEn}</span>
              <span class="lang-zh">{el.nameZh}</span>
            </a>
          ))}
        </div>
      </div>
    )}
    {samePeriod.length > 0 && (
      <div class="prop-card glass-glow">
        <h3><span class="lang-en">Same Period ({e.period})</span><span class="lang-zh">同周期（第{e.period}周期）</span></h3>
        <div class="related-grid">
          {samePeriod.map(el => (
            <a href={`/${locale}/element/${el.z}`} target="_blank" class="related-chip" style={`--chip-color: ${getCategoryColor(el.category)}`}>
              <span class="related-symbol">{el.symbol}</span>
              <span class="lang-en">{el.nameEn}</span>
              <span class="lang-zh">{el.nameZh}</span>
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="prop-card glass-glow">
      <h3><span class="lang-en">References</span><span class="lang-zh">参考来源</span></h3>
      <ul class="prop-list prop-list-bullet lang-en">
        <li><a href="https://pubchem.ncbi.nlm.nih.gov/element/{e.symbol}" rel="external nofollow" target="_blank">PubChem — {e.nameEn}</a></li>
        <li><a href={`https://en.wikipedia.org/wiki/${e.nameEn}`} rel="external nofollow" target="_blank">Wikipedia — {e.nameEn}</a></li>
        <li><a href="https://www.rsc.org/periodic-table/element/{e.z}/{e.symbol.toLowerCase()}" rel="external nofollow" target="_blank">Royal Society of Chemistry</a></li>
        <li><a href={`https://webbook.nist.gov/cgi/cbook.cgi?Formula=${e.symbol}`} rel="external nofollow" target="_blank">NIST Chemistry WebBook</a></li>
      </ul>
      <ul class="prop-list prop-list-bullet lang-zh">
        <li><a href="https://pubchem.ncbi.nlm.nih.gov/element/{e.symbol}" rel="external nofollow" target="_blank">PubChem — {e.nameZh}</a></li>
        <li><a href={`https://zh.wikipedia.org/wiki/${e.nameZh}`} rel="external nofollow" target="_blank">维基百科 — {e.nameZh}</a></li>
        <li><a href="https://www.rsc.org/periodic-table/element/{e.z}/{e.symbol.toLowerCase()}" rel="external nofollow" target="_blank">英国皇家化学学会</a></li>
        <li><a href={`https://webbook.nist.gov/cgi/cbook.cgi?Formula=${e.symbol}`} rel="external nofollow" target="_blank">NIST 化学 WebBook</a></li>
      </ul>
    </div>
  </div>

  <div class="detail-actions">
    <button class="btn-compare glass-glow" id="btn-compare" data-z={String(e.z)}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 3h5v5M8 3H3v5M3 16v5h5M21 16v5h-5M21 3l-7 7M3 3l7 7M3 21l7-7M21 21l-7-7"/>
      </svg>
      <span class="lang-en">Add to Compare</span>
      <span class="lang-zh">加入对比</span>
    </button>
    <a href={`/${locale}/compare`} class="btn-compare glass-glow btn-compare-link">
      <span class="lang-en">View Compare</span>
      <span class="lang-zh">查看对比</span>
    </a>
  </div>

  <!-- Category info modal -->
  <div class="cat-modal-overlay" id="cat-modal" hidden>
    <div class="cat-modal glass-glow">
      <div class="cat-modal-header">
        <h3><span class="lang-en">Element Categories</span><span class="lang-zh">元素分类说明</span></h3>
        <button class="cat-modal-close" id="cat-modal-close">&times;</button>
      </div>
      <div class="cat-modal-grid">
        {CATEGORIES.map(cat => (
          <div class="cat-modal-item" style={`--cat-accent: var(--cat-${cat.key});`}>
            <div class="cat-modal-bar"></div>
            <div class="cat-modal-body">
              <strong><span class="lang-en">{cat.label}</span><span class="lang-zh">{cat.labelZh}</span></strong>
              <p class="lang-en">{cat.desc}</p>
              <p class="lang-zh">{cat.descZh}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</article>

<script>
  import { addToCompare, removeFromCompare, isInCompare } from '../utils/compare';
  const btn = document.getElementById('btn-compare') as HTMLButtonElement;
  const z = parseInt(btn.dataset.z || '0');

  function updateBtn() {
    const added = isInCompare(z);
    btn.classList.toggle('is-added', added);
    const en = btn.querySelector('.lang-en')!;
    const zh = btn.querySelector('.lang-zh')!;
    const lang = document.documentElement.getAttribute('data-lang') || 'en';
    if (added) {
      en.textContent = '✓ Added';
      zh.textContent = '✓ 已添加';
    } else {
      en.textContent = 'Add to Compare';
      zh.textContent = '加入对比';
    }
  }

  updateBtn();
  window.addEventListener('compare-updated', updateBtn);
  btn.addEventListener('click', () => isInCompare(z) ? removeFromCompare(z) : addToCompare(z));

  // Category info modal
  const infoBtn = document.getElementById('cat-info-btn')!;
  const modal = document.getElementById('cat-modal')!;
  const closeBtn = document.getElementById('cat-modal-close')!;
  infoBtn.addEventListener('click', () => { modal.hidden = false; });
  closeBtn.addEventListener('click', () => { modal.hidden = true; });
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.hidden = true; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) modal.hidden = true; });
</script>

<style>
  .detail-root { max-width: 1100px; margin: 0 auto; padding: 1rem 1.5rem 4rem; }
  .detail-header { text-align: center; padding: 2rem 0 3rem; position: relative; }
  .detail-top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
  .back-btn { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  .back-btn:hover { color: var(--text-primary); }
  .detail-nav { display: flex; gap: 0.5rem; align-items: center; }
  .nav-current { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-dim); }
  .nav-arrow { color: var(--text-dim); text-decoration: none; font-family: var(--font-mono); font-size: 0.8rem; padding: 0.25rem 0.6rem; border-radius: var(--radius-sm); border: 1px solid var(--border-glass); transition: all 0.2s; }
  .nav-arrow:hover { color: var(--text-primary); border-color: var(--border-glow); background: rgba(0,0,0,0.02); }
  .detail-hero { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; }
  .detail-z { font-family: var(--font-mono); font-size: 1rem; color: var(--text-dim); }
  .detail-symbol { font-family: var(--font-mono); font-size: 5rem; font-weight: 700; line-height: 1; animation: fadeInUp 0.6s ease-out; }
  .detail-names { display: flex; gap: 0.75rem; align-items: baseline; }
  .detail-name-en { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--text-primary); }
  .detail-name-zh { font-size: 1.1rem; color: var(--text-secondary); }

  .detail-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .prop-card { padding: 1.25rem; border-radius: var(--radius-lg); }
  .prop-card h3 { font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 600; }
  .prop-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .prop-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 0.4rem; border-bottom: 1px solid rgba(0,0,0,0.03); }
  .prop-row dt { font-size: 0.8rem; color: var(--text-dim); flex-shrink: 0; }
  .prop-row dd { font-size: 0.85rem; color: var(--text-primary); text-align: right; font-weight: 500; }
  .prop-row dd.cap { text-transform: capitalize; }
  .electron-config { font-family: var(--font-mono); font-size: 0.8rem; }
  .prop-text { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6; }
