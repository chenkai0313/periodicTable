---
// TrendControls.astro — Property heatmap, temperature simulator, discovery timeline
---

<div class="tc-root glass-glow" id="tc-root">
  <!-- Property Heatmap -->
  <div class="tc-section">
    <label class="tc-label">
      <span class="lang-en">Trend Heatmap</span>
      <span class="lang-zh">趋势热力图</span>
    </label>
    <select id="tc-property" class="tc-select">
      <option value="" class="lang-en">— Select property —</option>
      <option value="" class="lang-zh">— 选择属性 —</option>
      <option value="electroneg" class="lang-en">Electronegativity</option>
      <option value="electroneg" class="lang-zh">电负性</option>
      <option value="radius" class="lang-en">Atomic Radius (calc.)</option>
      <option value="radius" class="lang-zh">原子半径(计算)</option>
      <option value="melt" class="lang-en">Melting Point</option>
      <option value="melt" class="lang-zh">熔点</option>
      <option value="boil" class="lang-en">Boiling Point</option>
      <option value="boil" class="lang-zh">沸点</option>
      <option value="density" class="lang-en">Density (STP)</option>
      <option value="density" class="lang-zh">密度(标准)</option>
      <option value="ionize" class="lang-en">1st Ionization Energy</option>
      <option value="ionize" class="lang-zh">第一电离能</option>
      <option value="affinity" class="lang-en">Electron Affinity</option>
      <option value="affinity" class="lang-zh">电子亲和能</option>
      <option value="abundance" class="lang-en">Crust Abundance</option>
      <option value="abundance" class="lang-zh">地壳丰度</option>
    </select>
    <div class="tc-legend" id="tc-legend" hidden>
      <div class="legend-gradient" id="tc-legend-bar"></div>
      <div class="legend-labels">
        <span class="legend-label" id="tc-legend-min"></span>
        <span class="legend-label" id="tc-legend-max"></span>
      </div>
    </div>
  </div>

  <!-- Temperature State Simulator -->
  <div class="tc-section">
    <label class="tc-label">
      <span class="lang-en">Temperature</span>
      <span class="lang-zh">温度模拟</span>
    </label>
    <div class="tc-temp-row">
      <input type="range" id="tc-temp" class="tc-range" min="0" max="6000" value="293" step="1" />
      <span class="tc-temp-val" id="tc-temp-display">293 K</span>
      <button class="tc-unit-btn" id="tc-temp-unit">°C</button>
    </div>
    <div class="tc-state-legend">
      <span class="state-badge state-solid"><span class="state-dot solid-dot"></span> <span class="lang-en">Solid</span><span class="lang-zh">固体</span></span>
      <span class="state-badge state-liquid"><span class="state-dot liquid-dot"></span> <span class="lang-en">Liquid</span><span class="lang-zh">液体</span></span>
      <span class="state-badge state-gas"><span class="state-dot gas-dot"></span> <span class="lang-en">Gas</span><span class="lang-zh">气体</span></span>
    </div>
  </div>

  <!-- Discovery Timeline -->
  <div class="tc-section">
    <label class="tc-label">
      <span class="lang-en">Discovery Timeline</span>
      <span class="lang-zh">发现时间线</span>
    </label>
    <div class="tc-timeline-row">
      <input type="range" id="tc-timeline" class="tc-range" min="-4000" max="2024" value="2024" step="1" />
      <span class="tc-timeline-val" id="tc-timeline-display">2024</span>
    </div>
  </div>

  <!-- Reset -->
  <button class="tc-reset" id="tc-reset">
    <span class="lang-en">Reset All</span>
    <span class="lang-zh">全部重置</span>
  </button>
</div>

<script>
  (function() {
    let trendData = null;
    let heatmapProp = '';
    let tempK = 293;
    let tempUnit = 'K';
    let timelineYear = 2024;

    const tables = () => document.querySelectorAll('.periodic-table, .periodic-table-f');
    const tiles = () => document.querySelectorAll('.element-tile');

    const propSelect = document.getElementById('tc-property');
    const legendEl = document.getElementById('tc-legend');
    const legendBar = document.getElementById('tc-legend-bar');
    const legendMin = document.getElementById('tc-legend-min');
    const legendMax = document.getElementById('tc-legend-max');
    const tempSlider = document.getElementById('tc-temp');
    const tempDisplay = document.getElementById('tc-temp-display');
    const tempUnitBtn = document.getElementById('tc-temp-unit');
    const timelineSlider = document.getElementById('tc-timeline');
    const timelineDisplay = document.getElementById('tc-timeline-display');
    const resetBtn = document.getElementById('tc-reset');

    async function loadData() {
      if (trendData) return trendData;
      try {
        const res = await fetch('/elements.json');
        const raw = await res.json();
        trendData = raw.filter(function(e) { return typeof e === 'object' && e.atomic; });
        return trendData;
      } catch (err) {
        console.error('Trend data load failed:', err);
        return [];
      }
    }

    function getPropValue(el, prop) {
      switch (prop) {
        case 'electroneg': { var v = parseFloat(el.electroneg); return isNaN(v) ? null : v; }
        case 'radius': { var v = parseFloat(el.radius?.calculated); return isNaN(v) ? null : v; }
        case 'melt': { var v = parseFloat(el.melt); return isNaN(v) ? null : v; }
        case 'boil': { var v = parseFloat(el.boil); return isNaN(v) ? null : v; }
        case 'density': { var v = parseFloat(el.density?.stp); return isNaN(v) ? null : v; }
        case 'ionize': { var v = parseFloat(el.ionize?.['1']); return isNaN(v) ? null : v; }
        case 'affinity': { var v = parseFloat(el.affinity); return isNaN(v) ? null : v; }
        case 'abundance': { var v = parseFloat(el.abundance?.crust); return isNaN(v) ? null : v; }
        default: return null;
      }
    }

    function getPropUnit(prop) {
      switch (prop) {
        case 'electroneg': return 'Pauling';
        case 'radius': return 'pm';
        case 'melt': return 'K';
        case 'boil': return 'K';
        case 'density': return 'g/cm³';
        case 'ionize': return 'kJ/mol';
        case 'affinity': return 'kJ/mol';
        case 'abundance': return '%';
        default: return '';
      }
    }

    function valueToColor(t, hueRange) {
      hueRange = hueRange || 220;
      var hue = hueRange - t * hueRange;
      var sat = 80;
      var light = 50 + t * 12;
      var alpha = 0.55 + t * 0.2;
      return {
        bg: 'hsla(' + hue + ', ' + sat + '%, ' + light + '%, ' + alpha + ')',
        border: 'hsla(' + hue + ', ' + sat + '%, ' + (light - 10) + '%, ' + (0.65 + t * 0.3) + ')',
      };
    }

    function applyHeatmap() {
      if (!trendData || !heatmapProp) {
        tiles().forEach(function(t) {
          t.style.removeProperty('--ht-bg');
          t.style.removeProperty('--ht-border');
          t.classList.remove('ht-colored');
        });
        tables().forEach(function(tb) { tb.classList.remove('heatmap-active'); });
        legendEl.hidden = true;
        return;
      }

      var pairs = [];
      trendData.forEach(function(el) {
        var v = getPropValue(el, heatmapProp);
        if (v != null) pairs.push({ z: el.atomic, val: v });
      });
      if (pairs.length === 0) return;

      var vals = pairs.map(function(p) { return p.val; });
      var min = Infinity, max = -Infinity;
      vals.forEach(function(v) { if (v < min) min = v; if (v > max) max = v; });
      var range = max - min || 1;

      var lookup = {};
      pairs.forEach(function(p) { lookup[p.z] = p; });

      var unit = getPropUnit(heatmapProp);
      var minFmt = (min < 0.01 ? min.toExponential(1) : min.toFixed ? min.toFixed(2) : min);
      var maxFmt = (max < 0.01 ? max.toExponential(1) : max.toFixed ? max.toFixed(2) : max);

      legendBar.style.background = 'linear-gradient(to right, hsl(220, 75%, 36%), hsl(180, 75%, 40%), hsl(120, 75%, 35%), hsl(60, 75%, 35%), hsl(0, 75%, 46%))';
      legendMin.textContent = minFmt + ' ' + unit;
      legendMax.textContent = maxFmt + ' ' + unit;
      legendEl.hidden = false;

      tiles().forEach(function(tile) {
        var z = tile.dataset.z;
        var pair = lookup[z];
        if (pair) {
          var t = (pair.val - min) / range;
          var c = valueToColor(t);
          tile.style.setProperty('--ht-bg', c.bg);
          tile.style.setProperty('--ht-border', c.border);
          tile.classList.add('ht-colored');
        } else {
          tile.style.removeProperty('--ht-bg');
          tile.style.removeProperty('--ht-border');
          tile.classList.remove('ht-colored');
        }
      });

      tables().forEach(function(tb) { tb.classList.add('heatmap-active'); });
    }

    function determineState(el) {
      var m = parseFloat(el.melt);
      var b = parseFloat(el.boil);
      if (isNaN(m) && isNaN(b)) return 'unknown';
      if (!isNaN(b) && tempK >= b) return 'gas';
      if (!isNaN(m) && tempK >= m && !isNaN(b) && tempK < b) return 'liquid';
      if (!isNaN(m) && tempK < m) return 'solid';
      if (!isNaN(b) && tempK < b) return 'solid';
      return 'unknown';
    }

    function applyTemperature() {
      if (!trendData) return;
      var lookup = {};
      trendData.forEach(function(el) { lookup[el.atomic] = el; });

      tiles().forEach(function(tile) {
        var z = tile.dataset.z;
        var el = lookup[z];
        if (!el) return;
        tile.classList.remove('tc-solid', 'tc-liquid', 'tc-gas', 'tc-state-unknown');
        var state = determineState(el);
        tile.classList.add('tc-' + state);
      });

      tables().forEach(function(tb) { tb.classList.add('temperature-active'); });
      updateTempDisplay();
    }

    function updateTempDisplay() {
      if (tempUnit === 'K') {
        tempDisplay.textContent = tempK + ' K';
      } else {
        var c = tempK - 273.15;
        tempDisplay.textContent = (c >= 0 ? '+' : '') + c.toFixed(0) + ' °C';
      }
    }

    function clearTemperature() {
      tiles().forEach(function(t) {
        t.classList.remove('tc-solid', 'tc-liquid', 'tc-gas', 'tc-state-unknown');
      });
      tables().forEach(function(tb) { tb.classList.remove('temperature-active'); });
    }

    function applyTimeline() {
      tiles().forEach(function(tile) {
        var z = parseInt(tile.dataset.z);
        var el = trendData ? trendData.find(function(e) { return parseInt(e.atomic) === z; }) : null;
        if (!el || el.discover == null) {
          tile.classList.remove('tc-timeline-hidden');
          return;
        }
        var dYear = parseInt(el.discover);
        if (isNaN(dYear)) {
          tile.classList.remove('tc-timeline-hidden');
          return;
        }
        if (dYear <= timelineYear) {
          tile.classList.remove('tc-timeline-hidden');
        } else {
          tile.classList.add('tc-timeline-hidden');
        }
      });

      tables().forEach(function(tb) { tb.classList.toggle('timeline-active', timelineYear < 2024); });
      updateTimelineDisplay();
    }

    function updateTimelineDisplay() {
      var y = timelineYear;
      var en, zh;
      if (y < 0) {
        en = (-y) + ' BCE';
        zh = '公元前 ' + (-y) + ' 年';
      } else {
        en = y + ' CE';
        zh = '公元 ' + y + ' 年';
      }
      timelineDisplay.innerHTML = '<span class="lang-en">' + en + '</span><span class="lang-zh">' + zh + '</span>';
    }

    function clearTimeline() {
      tiles().forEach(function(t) { t.classList.remove('tc-timeline-hidden'); });
      tables().forEach(function(tb) { tb.classList.remove('timeline-active'); });
    }

    function resetAll() {
      heatmapProp = '';
      propSelect.value = '';
      tempK = 293;
      tempUnit = 'K';
      tempSlider.value = 293;
      tempUnitBtn.textContent = '°C';
      timelineYear = 2024;
      timelineSlider.value = 2024;

      applyHeatmap();
      clearTemperature();
      clearTimeline();
      updateTempDisplay();
      updateTimelineDisplay();

      var searchInput = document.getElementById('search-input');
      if (searchInput) { searchInput.value = ''; searchInput.dispatchEvent(new Event('input')); }
      var allChip = document.querySelector('.category-reset');
      if (allChip) allChip.click();
    }

    propSelect.addEventListener('change', function() {
      heatmapProp = propSelect.value;
      applyHeatmap();
    });

    tempSlider.addEventListener('input', function() {
      tempK = parseInt(tempSlider.value);
      applyTemperature();
    });

    tempUnitBtn.addEventListener('click', function() {
      tempUnit = tempUnit === 'K' ? 'C' : 'K';
      tempUnitBtn.textContent = tempUnit === 'K' ? '°C' : 'K';
      updateTempDisplay();
    });

    timelineSlider.addEventListener('input', function() {
      timelineYear = parseInt(timelineSlider.value);
      applyTimeline();
    });

    resetBtn.addEventListener('click', resetAll);

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { resetAll(); }
    });

    loadData().then(function() {
      updateTempDisplay();
      updateTimelineDisplay();
    });
  })();
</script>

<style>
  .tc-root {
    max-width: 1400px; margin: 0 auto; padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg); border: 1px solid var(--border-glass);
    display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: flex-start;
  }
  .tc-section {
    display: flex; flex-direction: column; gap: 0.5rem;
    min-width: 200px;
  }
  .tc-label {
    font-family: var(--font-display); font-size: 0.75rem; font-weight: 600;
    color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.05em;
  }
  .tc-select {
    padding: 0.45rem 0.75rem; background: var(--bg-card);
    border: 1px solid var(--border-glass); border-radius: var(--radius-md);
    color: var(--text-primary); font-family: var(--font-body);
    font-size: 0.82rem; outline: none; cursor: pointer;
    transition: border-color 0.2s;
  }
  .tc-select:focus { border-color: var(--accent-blue); }

  /* Legend */
  .tc-legend { margin-top: 0.4rem; }
  .legend-gradient {
    height: 10px; border-radius: 5px;
  }
  .legend-labels {
    display: flex; justify-content: space-between;
    margin-top: 0.25rem;
  }
  .legend-label {
    font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-dim);
  }

  /* Temperature */
  .tc-temp-row {
    display: flex; align-items: center; gap: 0.5rem;
  }
  .tc-range {
    flex: 1; -webkit-appearance: none; appearance: none;
    height: 6px; border-radius: 3px;
    background: linear-gradient(to right, var(--accent-blue), var(--accent-red));
    outline: none; cursor: pointer; min-width: 120px;
  }
  .tc-range::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 18px; height: 18px; border-radius: 50%;
    background: #fff; border: 2px solid var(--text-primary);
    box-shadow: var(--shadow-sm); cursor: pointer;
  }
  .tc-range::-moz-range-thumb {
    width: 18px; height: 18px; border-radius: 50%;
    background: #fff; border: 2px solid var(--text-primary);
    box-shadow: var(--shadow-sm); cursor: pointer;
  }
  .tc-temp-val {
    font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-primary);
    min-width: 5em; text-align: right;
  }
  .tc-timeline-val {
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-primary);
    min-width: 16em; text-align: right;
  }
  .tc-unit-btn {
    padding: 0.25rem 0.6rem; background: var(--bg-card);
    border: 1px solid var(--border-glass); border-radius: var(--radius-sm);
    color: var(--text-secondary); font-family: var(--font-mono);
    font-size: 0.75rem; cursor: pointer; transition: all 0.2s;
  }
  .tc-unit-btn:hover { border-color: var(--text-primary); color: var(--text-primary); }
  .tc-state-legend {
    display: flex; gap: 1rem; font-size: 0.75rem; color: var(--text-secondary);
  }
  .state-badge { display: flex; align-items: center; gap: 0.35rem; }
  .state-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .solid-dot { background: rgba(74, 158, 255, 0.5); }
  .liquid-dot { background: rgba(46, 196, 182, 0.5); }
  .gas-dot { background: rgba(255, 94, 91, 0.5); }

  /* Timeline */
  .tc-timeline-row {
    display: flex; align-items: center; gap: 0.5rem;
  }

  /* Reset */
  .tc-reset {
    align-self: flex-end; margin-left: auto;
    padding: 0.45rem 1rem; background: transparent;
    border: 1px solid var(--border-glass); border-radius: var(--radius-md);
    color: var(--text-dim); font-family: var(--font-body);
    font-size: 0.78rem; cursor: pointer; transition: all 0.2s;
  }
  .tc-reset:hover { border-color: var(--text-primary); color: var(--text-primary); background: rgba(0,0,0,0.02); }

  /* ---- Tile state styles (global) ---- */
  :global(.heatmap-active .element-tile.ht-colored) {
    background: var(--ht-bg, var(--bg-card)) !important;
    border-color: var(--ht-border, var(--border-glass)) !important;
  }

  :global(.temperature-active .element-tile.tc-solid) {
    background: rgba(74, 158, 255, 0.22) !important;
    border-color: rgba(74, 158, 255, 0.5) !important;
  }
  :global(.temperature-active .element-tile.tc-liquid) {
    background: rgba(46, 196, 182, 0.22) !important;
    border-color: rgba(46, 196, 182, 0.5) !important;
  }
  :global(.temperature-active .element-tile.tc-gas) {
    background: rgba(255, 94, 91, 0.22) !important;
    border-color: rgba(255, 94, 91, 0.5) !important;
  }
  :global(.temperature-active .element-tile.tc-unknown) {
    opacity: 0.25; filter: grayscale(0.6);
  }

  :global(.timeline-active .element-tile.tc-timeline-hidden) {
    opacity: 0.1; filter: grayscale(0.8) brightness(0.4); pointer-events: none;
  }

  @media (max-width: 768px) {
    .tc-root { padding: 1rem; gap: 1rem; }
    .tc-section { min-width: 100%; }
    .tc-reset { margin-left: 0; align-self: stretch; }
  }
</style>
