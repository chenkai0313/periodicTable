---
// ParticleBg.astro — Subtle dots + colorful graph-paper grid
---
<style is:global>
  .particle-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
  }
  .particle-bg::before {
    content: '';
    position: absolute; inset: -50%;
    background-image:
      radial-gradient(0.6px 0.6px at 10% 20%, rgba(0,0,0,0.03), transparent),
      radial-gradient(0.5px 0.5px at 20% 60%, rgba(0,0,0,0.025), transparent),
      radial-gradient(0.7px 0.7px at 35% 15%, rgba(0,0,0,0.04), transparent),
      radial-gradient(0.4px 0.4px at 50% 45%, rgba(0,0,0,0.025), transparent),
      radial-gradient(0.6px 0.6px at 65% 75%, rgba(0,0,0,0.03), transparent),
      radial-gradient(0.5px 0.5px at 80% 30%, rgba(0,0,0,0.025), transparent),
      radial-gradient(0.7px 0.7px at 15% 85%, rgba(0,0,0,0.03), transparent),
      radial-gradient(0.4px 0.4px at 40% 90%, rgba(0,0,0,0.025), transparent),
      radial-gradient(0.6px 0.6px at 70% 10%, rgba(0,0,0,0.03), transparent),
      radial-gradient(0.5px 0.5px at 90% 55%, rgba(0,0,0,0.025), transparent),
      radial-gradient(0.7px 0.7px at 55% 70%, rgba(0,0,0,0.03), transparent),
      radial-gradient(0.4px 0.4px at 25% 40%, rgba(0,0,0,0.025), transparent);
    background-size: 200% 200%;
    animation: starDrift 120s linear infinite;
  }
  @keyframes starDrift {
    0% { transform: translate(0,0); }
    25% { transform: translate(1%,-0.5%); }
    50% { transform: translate(0.5%,1%); }
    75% { transform: translate(-0.5%,0.5%); }
    100% { transform: translate(0,0); }
  }
  .particle-bg::after {
    content: '';
    position: absolute; inset: 0;
    /* Colorful graph-paper grid — horizontal lines blue, vertical lines purple-teal */
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 23px,
        rgba(74, 158, 255, 0.10) 23px,
        rgba(74, 158, 255, 0.10) 24px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 23px,
        rgba(124, 111, 247, 0.09) 23px,
        rgba(124, 111, 247, 0.09) 24px
      ),
      repeating-linear-gradient(
        90deg,
        transparent,
        transparent 47px,
        rgba(46, 196, 182, 0.08) 47px,
        rgba(46, 196, 182, 0.08) 48px
      );
    /* Keep grid visible across most of the page */
    mask-image: radial-gradient(
      ellipse at 50% 50%,
      rgba(0,0,0,0.85) 0%,
      rgba(0,0,0,0.7) 50%,
      rgba(0,0,0,0.35) 100%
    );
  }
</style>

<div class="particle-bg" aria-hidden="true"></div>
