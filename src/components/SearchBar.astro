---
import { CATEGORIES } from '../utils/elements';
---

<div class="search-bar-wrapper">
  <div class="search-input-wrap">
    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    </svg>
    <input type="text" id="search-input" class="search-input" placeholder="Search element..." data-placeholder-en="Search element..." data-placeholder-zh="搜索元素..." autocomplete="off" />
    <button id="search-clear" class="search-clear" aria-label="Clear">&times;</button>
  </div>
  <div class="category-chips" id="category-chips">
    {CATEGORIES.map(cat => (
      <button class="category-chip" data-category={cat.key} style={`--chip-color: var(--cat-${cat.key});`}>
        <span class="lang-en">{cat.label}</span><span class="lang-zh">{cat.labelZh}</span>
      </button>
    ))}
    <button class="category-chip category-reset is-active" data-category="all" style="--chip-color: #333;">
      <span class="lang-en">All Elements</span><span class="lang-zh">全部元素</span>
    </button>
  </div>
</div>

<script>
  function setupSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    const clearBtn = document.getElementById('search-clear') as HTMLButtonElement;
    const chips = document.querySelectorAll('.category-chip');
    const table = document.querySelector('.periodic-table');
    let activeCategory = 'all';

    // Language-aware placeholder
    function updatePlaceholder() {
      const lang = document.documentElement.getAttribute('data-lang') || 'en';
      input.placeholder = lang === 'zh'
        ? (input.dataset.placeholderZh || '搜索元素...')
        : (input.dataset.placeholderEn || 'Search element...');
    }
    updatePlaceholder();
    window.addEventListener('lang-changed', updatePlaceholder);

    function apply() {
      const query = input.value.toLowerCase().trim();
      table?.classList.toggle('search-filtering', query.length > 0);
      table?.classList.toggle('category-filtering', activeCategory !== 'all');
      document.querySelectorAll('.periodic-table-f')?.forEach(t => {
        t.classList.toggle('search-filtering', query.length > 0);
        t.classList.toggle('category-filtering', activeCategory !== 'all');
      });
      clearBtn.style.display = query ? 'flex' : 'none';

      document.querySelectorAll('.element-tile').forEach(tile => {
        const el = tile as HTMLElement;
        const sym = el.querySelector('.tile-symbol')?.textContent?.toLowerCase() || '';
        const nameEn = el.querySelector('.tile-name-en')?.textContent?.toLowerCase() || '';
        const nameZh = el.querySelector('.tile-name-zh')?.textContent || '';
        const z = el.dataset.z || '';
        const cat = el.dataset.category || '';

        const matchSearch = !query || sym.includes(query) || nameEn.includes(query) || nameZh.includes(query) || z === query;
        const matchCat = activeCategory === 'all' || cat === activeCategory;
        el.classList.toggle('search-match', matchSearch);
        el.classList.toggle('category-match', matchCat);
      });
    }

    input.addEventListener('input', apply);
    clearBtn.addEventListener('click', () => { input.value = ''; apply(); });
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        activeCategory = chip.dataset.category || 'all';
        chips.forEach(c => c.classList.remove('is-active'));
        chip.classList.add('is-active');
        apply();
      });
    });
  }
  setupSearch();
</script>

<style>
  .search-bar-wrapper {
    display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;
    position: sticky; top: 60px; z-index: 50; padding: 1rem 0;
    background: linear-gradient(to bottom, var(--bg-root) 60%, transparent);
    backdrop-filter: blur(4px);
  }
  .search-input-wrap { position: relative; max-width: 480px; width: 100%; }
  .search-icon {
    position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
    color: var(--text-dim); pointer-events: none;
  }
  .search-input {
    width: 100%; padding: 0.7rem 2.5rem 0.7rem 2.6rem;
    background: var(--bg-card); border: 1px solid var(--border-glass);
    border-radius: var(--radius-xl); color: var(--text-primary);
    font-family: var(--font-body); font-size: 0.95rem; outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .search-input::placeholder { color: var(--text-dim); }
  .search-input:focus {
    border-color: transparent;
    box-shadow: 0 0 0 2px var(--accent-blue), 0 0 20px rgba(74, 158, 255, 0.15);
  }
  .search-clear {
    display: none; position: absolute; right: 10px; top: 50%;
    transform: translateY(-50%); background: none; border: none;
    color: var(--text-dim); font-size: 1.2rem; cursor: pointer;
    width: 28px; height: 28px; align-items: center; justify-content: center;
    border-radius: 50%; transition: background 0.15s;
  }
  .search-clear:hover { background: rgba(0,0,0,0.04); color: var(--text-primary); }
  .category-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .category-chip {
    padding: 0.35rem 0.75rem; border-radius: var(--radius-xl);
    border: 1px solid color-mix(in srgb, var(--chip-color) 25%, transparent);
    background: color-mix(in srgb, var(--chip-color) 5%, transparent);
    color: var(--text-secondary); font-size: 0.75rem; font-family: var(--font-body);
    font-weight: 500; cursor: pointer; transition: all 0.2s; white-space: nowrap;
  }
  .category-chip:hover {
    background: color-mix(in srgb, var(--chip-color) 12%, transparent);
    border-color: color-mix(in srgb, var(--chip-color) 55%, transparent);
    color: var(--text-primary);
  }
  .category-chip.is-active {
    background: color-mix(in srgb, var(--chip-color) 50%, transparent);
    border-color: var(--chip-color); color: #fff;
    box-shadow: 0 2px 12px color-mix(in srgb, var(--chip-color) 20%, transparent);
  }
  .category-reset { --chip-color: #444; }
  .category-reset.is-active { color: #fff; }
</style>
