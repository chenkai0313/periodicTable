---
import Layout from '../../components/Layout.astro';
const today = '2026-05-14';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'zh' } }];
}

const locale = Astro.params.locale || 'en';
---
<Layout
  title={locale === 'zh' ? '服务条款 — PeriodicTable 使用协议' : 'Terms of Service — PeriodicTable'}
  description={locale === 'zh' ? 'PeriodicTable 服务条款：本网站仅供教育用途，数据按"原样"提供。使用前请阅读完整条款。' : 'PeriodicTable Terms of Service: educational use only, data provided as-is. Read the full terms before using the site.'}
  pathname={`/${locale}/terms`}
  ogType="article"
  currentLocale={locale}
>
<div class="page-root"><article class="page-article glass-glow">
  <h1><span class="lang-en">Terms of Service</span><span class="lang-zh">服务条款</span></h1>
  <p class="page-date"><span class="lang-en">Effective: {today}</span><span class="lang-zh">生效日期：{today}</span></p>
  <section class="lang-en">
    <h2>1. Acceptance</h2><p>By accessing PeriodicTable you agree to these terms.</p>
    <h2>2. Educational Purpose</h2><p>Data is provided for educational use. Verify against official sources for safety-critical applications.</p>
    <h2>3. Disclaimer</h2><p>The site is provided "as is" without warranties. Contact: <a href="mailto:ckck0313@gmail.com">ckck0313@gmail.com</a>.</p>
  </section>
  <section class="lang-zh">
    <h2>1. 接受条款</h2><p>访问 PeriodicTable 即表示您同意本条款。</p>
    <h2>2. 教育目的</h2><p>数据仅供教育用途。安全关键应用请与官方来源核实。</p>
    <h2>3. 免责声明</h2><p>本网站按"原样"提供，不作任何保证。联系：<a href="mailto:ckck0313@gmail.com">ckck0313@gmail.com</a>。</p>
  </section>
</article></div>
</Layout>
<style>
  .page-root { max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  .page-article { padding: 2rem 2.5rem; border-radius: var(--radius-lg); }
  .page-article h1 { font-size: 1.8rem; font-weight: 700; margin-bottom: 0.5rem; }
  .page-article h2 { font-size: 1.2rem; font-weight: 600; margin: 2rem 0 0.75rem; color: var(--text-primary); }
  .page-article p { font-size: 0.95rem; line-height: 1.75; color: var(--text-secondary); }
  .page-article a { color: var(--accent-blue); text-decoration: underline; }
  .page-date { color: var(--text-dim); font-size: 0.8rem; margin-bottom: 2rem; }
</style>
