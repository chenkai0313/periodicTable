---
import Layout from '../../components/Layout.astro';

export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'zh' } }];
}

const locale = Astro.params.locale || 'en';
---

<Layout
  title={locale === 'zh' ? '化学元素对比 — 元素周期表多元素属性并排比较工具' : 'Compare Chemical Elements — Periodic Table Side-by-Side Comparison Tool'}
  description={locale === 'zh' ? '化学元素周期表在线对比工具：同时比较 2-4 种化学元素的原子量、电负性、熔点、沸点、密度、电子排布、氧化态等详细属性。从周期表中选择元素即可开始并排对比。' : 'Compare chemical elements from the periodic table side by side: atomic weight, electronegativity, melting point, boiling point, density, electron configuration, oxidation states. Select elements from the periodic table to begin comparison.'}
  pathname={`/${locale}/compare`}
  currentLocale={locale}
>
  <div class="compare-page">
    <h1 class="compare-title lang-en">Element <span class="text-gradient">Comparison</span></h1>
    <h1 class="compare-title lang-zh">元素<span class="text-gradient">对比</span></h1>
    <p class="compare-sub lang-en">Select 2&ndash;4 elements from the periodic table or detail pages</p>
    <p class="compare-sub lang-zh">从周期表或详情页选择 2-4 个元素进行对比</p>
    <div class="compare-table-wrap" id="compare-table-wrap">
      <p class="compare-empty lang-en">Add elements to start comparing. Use the <b>Add to Compare</b> button on element detail pages.</p>
      <p class="compare-empty lang-zh">添加元素开始对比。在元素详情页点击<b>加入对比</b>按钮。</p>
    </div>
  </div>
</Layout>

<script>
  import { getCompareQueue } from '../../utils/compare';
  import { STATE_LABELS, BLOCK_LABELS, getCategoryLabel, getCategoryLabelZh } from '../../utils/elements';

  async function loadElements() {
    const res = await fetch('/elements-data.json');
    const allElements = await res.json();
    const elMap = new Map((allElements as any[]).map((e: any) => [e.z, e]));
    renderCompare(elMap);
  }

  function renderCompare(elMap: Map<number, any>) {
    const queue = getCompareQueue();
    const wrap = document.getElementById('compare-table-wrap')!;
    if (queue.length === 0) {
      const lang = document.documentElement.getAttribute('data-lang') || 'en';
      if (lang === 'zh') {
        wrap.innerHTML = '<p class="compare-empty">添加元素开始对比。在元素详情页点击<b>加入对比</b>按钮。</p>';
      } else {
        wrap.innerHTML = '<p class="compare-empty">Add elements to start comparing. Use the <b>Add to Compare</b> button on element detail pages.</p>';
      }
      return;
    }
    const elements = queue.map(z => elMap.get(z)).filter(Boolean);
    const lang = document.documentElement.getAttribute('data-lang') || 'en';
    const isZh = lang === 'zh';

    const props = isZh ? [
      { key: 'z', label: '原子序数' },
      { key: 'symbol', label: '符号' },
      { key: 'nameEn', label: '英文名' },
      { key: 'nameZh', label: '中文名' },
      { key: 'weight', label: '原子量' },
      { key: 'category', label: '分类' },
      { key: 'state', label: '状态' },
      { key: 'period', label: '周期' },
      { key: 'group', label: '族' },
      { key: 'block', label: '区' },
      { key: 'electronegativity', label: '电负性' },
      { key: 'atomicRadius', label: '原子半径 (pm)' },
      { key: 'melting', label: '熔点 (°C)' },
      { key: 'boiling', label: '沸点 (°C)' },
      { key: 'density', label: '密度 (g/cm³)' },
      { key: 'electronConfig', label: '电子排布' },
      { key: 'oxidation', label: '氧化态' },
      { key: 'uses', label: '用途' },
    ] : [
      { key: 'z', label: 'Atomic Number' },
      { key: 'symbol', label: 'Symbol' },
      { key: 'nameEn', label: 'Name (EN)' },
      { key: 'nameZh', label: 'Name (ZH)' },
      { key: 'weight', label: 'Atomic Weight' },
      { key: 'category', label: 'Category' },
      { key: 'state', label: 'State' },
      { key: 'period', label: 'Period' },
      { key: 'group', label: 'Group' },
      { key: 'block', label: 'Block' },
      { key: 'electronegativity', label: 'Electronegativity' },
      { key: 'atomicRadius', label: 'Atomic Radius (pm)' },
      { key: 'melting', label: 'Melting Point (°C)' },
      { key: 'boiling', label: 'Boiling Point (°C)' },
      { key: 'density', label: 'Density (g/cm³)' },
      { key: 'electronConfig', label: 'Electron Config' },
      { key: 'oxidation', label: 'Oxidation States' },
      { key: 'uses', label: 'Uses' },
    ];

    let html = `<div style="overflow-x:auto"><table class="compare-table"><thead><tr><th>${isZh ? '属性' : 'Property'}</th>`;
    for (const el of elements) {
      html += `<th style="color:var(--cat-${el.category})">${el.symbol}<br><small><span class="lang-en">${el.nameEn}</span><span class="lang-zh">${el.nameZh}</span></small></th>`;
    }
    html += '</tr></thead><tbody>';
    for (const prop of props) {
      html += '<tr><td class="prop-label">' + prop.label + '</td>';
      for (const el of elements) {
        let val = (el as any)[prop.key];
        if (Array.isArray(val)) val = val.join(', ');
        if (val === null || val === undefined || val === '') val = '—';
        if (prop.key === 'category') {
          val = isZh ? getCategoryLabelZh(val) : getCategoryLabel(val);
        } else if (prop.key === 'state') {
          val = isZh ? (STATE_LABELS[val] || val) : (val.charAt(0).toUpperCase() + val.slice(1));
        } else if (prop.key === 'block') {
          val = isZh ? (BLOCK_LABELS[val] || (val + '区')) : (val + '-block');
        }
        html += `<td>${val}</td>`;
      }
      html += '</tr>';
    }
    html += '</tbody></table></div>';
    wrap.innerHTML = html;
  }

  loadElements();
  window.addEventListener('compare-updated', () => loadElements().then(() => renderCompare(new Map())));
</script>

<style>
  .compare-page { max-width: 1000px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
  .compare-title { text-align: center; margin-bottom: 0.5rem; }
  .compare-sub { text-align: center; color: var(--text-secondary); margin-bottom: 2rem; }
  .compare-empty { text-align: center; color: var(--text-dim); padding: 3rem; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; border: 1px solid var(--border-glass); }
  .compare-table th { text-align: center; padding: 0.75rem 1rem; border: 1px solid var(--border-glass); font-family: var(--font-mono); background: rgba(0,0,0,0.03); color: var(--text-primary); }
  .compare-table th:first-child { text-align: left; }
.compare-table th small { font-size: 0.65rem; color: var(--text-dim); font-weight: 400; }
  .compare-table td { padding: 0.6rem 1rem; border: 1px solid var(--border-glass); color: var(--text-secondary); text-align: center; }
  .compare-table .prop-label { color: var(--text-primary); font-weight: 600; white-space: nowrap; text-align: left; background: rgba(0,0,0,0.02); }
  .compare-table tr:hover td { background: rgba(0,0,0,0.03); }
</style>
